{
  // Deploy build.
  //
  // `@debe/shared` is published as TypeScript source rather than compiled
  // output, so the emit has to include it — hence `rootDir: ".."` and the
  // shared sources in `include`. That is why `main` in package.json points at
  // `lib/functions/src/index.js` and not `lib/index.js`: the extra path segment
  // is the price of not having a copied-and-pasted types file.
  //
  // The alternative — publishing `@debe/shared` to a registry and depending on
  // a version — is the right answer once more than one service consumes it.
  // For a single function it would be ceremony.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "..",
    "outDir": "lib",
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "../shared/src/**/*.ts", "../shared/src/**/*.json"]
}
